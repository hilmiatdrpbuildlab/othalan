# Local development. Leave DATABASE_URL empty to use the embedded PGlite database in .data/pglite
# (no Postgres server needed). Set it to a Neon dev-branch URL to develop against Neon.
DATABASE_URL=

# S3-compatible object storage (Neon Object Storage). Leave empty in dev to store files in .data/storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=othalan-media
STORAGE_REGION=us-east-2
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_IMAGE_TRANSFORMS=false
SESSION_SECRET=change-me-to-a-long-random-string

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM=Othalan <no-reply@othalan.cl>
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=

# Used only by `npm run db:seed` to create the first admin
SEED_ADMIN_EMAIL=admin@othalan.cl
SEED_ADMIN_PASSWORD=
