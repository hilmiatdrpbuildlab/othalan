{
	"name": "othalan-web",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:setup": "npm run db:migrate && npm run db:seed",
		"user:create": "tsx scripts/create-user.ts",
		"photos:team": "node scripts/process-team-photos.mjs"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261016.1",
		"@electric-sql/pglite": "^0.5.10",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.10.0",
		"dotenv": "^16.4.7",
		"drizzle-kit": "^0.31.11",
		"playwright-core": "^1.64.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^3.2.4",
		"wrangler": "^4.151.1"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/barlow-condensed": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@neondatabase/serverless": "^1.2.0",
		"@tabler/icons-svelte-runes": "^3.49.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.4",
		"marked": "^18.1.1",
		"valibot": "^1.5.0"
	}
}
